# ============================================================================
# Real Estate Valuation — biến môi trường production.
# Copy -> .env, sửa giá trị THẬT, rồi `chmod 600 .env`. KHÔNG commit .env.
# ============================================================================

# --- Spark cluster ---
# Driver trỏ master standalone. Đổi host nếu master ở node khác (multi-node).
SPARK_MASTER=spark://spark-master:7077
SPARK_SQL_SHUFFLE_PARTITIONS=16
SPARK_LOG_LEVEL=WARN
# Jar tải qua ivy (đã pre-warm trong image). PHẢI khớp Hadoop bundle của pyspark
# (pyspark 4.2.0 -> hadoop-client 3.5.0). Nếu 3.5.0 không resolve, thử 3.4.1.
SPARK_JARS_PACKAGES=org.apache.hadoop:hadoop-aws:3.5.0,org.apache.spark:spark-sql-kafka-0-10_2.13:4.2.0,org.postgresql:postgresql:42.7.4

# --- Object store (MinIO / S3) : data lake + model binary ---
LAKE_ROOT=s3a://realestate-lake
MODEL_STORE=s3a://realestate-models
RAW_CSV_ROOT=s3a://realestate-lake/raw_csv
# JSON điều khiển nhỏ (driver đọc bằng open()) -> volume local trong container:
META_DIR=/app/models_meta

S3_ENDPOINT=http://minio:9000
S3_SSL_ENABLED=false
# Dùng làm cả credential MinIO (root user/pass) và AWS creds cho s3a:
AWS_ACCESS_KEY_ID=CHANGE_ME_minio_access
AWS_SECRET_ACCESS_KEY=CHANGE_ME_minio_secret_min8chars
MINIO_LAKE_BUCKET=realestate-lake
MINIO_MODEL_BUCKET=realestate-models

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Postgres (serving) ---
PG_HOST=postgres
PG_PORT=5432
PG_DB=realestate
PG_USER=admin
PG_PASSWORD=CHANGE_ME_strong_db_password
# JDBC jar đã trong SPARK_JARS_PACKAGES -> để rỗng, tránh tải trùng qua ivy:
PG_DRIVER_PKG=

# --- vnstock (fetch macro series) ---
VNSTOCK_API_KEY=CHANGE_ME_or_leave_empty_for_community

# --- Java (Linux container). Ghi đè fallback trong ml/config.py ---
JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
